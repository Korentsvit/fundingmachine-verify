{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Korentsvit/fundingmachine-verify/blob/main/docs/verdict.schema.json",
 "title": "fm-verify verdict",
 "description": "What `fm-verify ... --json` prints and `fmverify.api.verify` answers for a well-formed request. A verdict is never a bare pass: it carries the statement its outcome supports, every check, what was relied on and what it does not establish.",
 "type": "object",
 "additionalProperties": false,
 "required": ["kind", "subject", "outcome", "statement", "checks", "relies_on", "does_not_establish", "checked_at", "tool"],
 "properties": {
  "kind": {"enum": ["merkle-inclusion", "opentimestamps", "rfc3161", "anchor-batch", "ledger-anchor", "anchor-set", "certificate", "event-chain", "text-disclosure", "root-chain"]},
  "subject": {"type": "string"},
  "outcome": {"enum": ["valid", "invalid", "indeterminate"]},
  "statement": {"type": "string", "minLength": 1},
  "checks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "status", "summary", "reasons", "relies_on", "required", "data"],
    "properties": {
     "id": {"type": "string", "minLength": 1},
     "status": {"enum": ["pass", "fail", "warn", "not_checked", "info"]},
     "summary": {"type": "string"},
     "reasons": {"type": "array", "items": {"type": "string"}},
     "relies_on": {"type": "array", "items": {"type": "string"}},
     "required": {"type": "boolean"},
     "data": {"type": "object"}
    }
   }
  },
  "relies_on": {"type": "array", "items": {"type": "string"}},
  "does_not_establish": {"type": "array", "minItems": 1, "items": {"type": "string"}},
  "checked_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
  "tool": {
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "version"],
   "properties": {"name": {"const": "fm-verify"}, "version": {"type": "string"}}
  },
  "html": {"type": "string", "description": "Only from the API, when the request asks for render: html."}
 }
}
